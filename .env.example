# PostgreSQL connection for local development. `docker compose up -d postgres` starts a matching
# server on localhost:5432 (user/password "brickflow", database "brickflow").
DATABASE_URL="postgresql://brickflow:brickflow@localhost:5432/brickflow"

# Optional: maximum connections in the app's pool (default 10).
# DATABASE_POOL_MAX="10"

# Databases the automated tests recreate on every run (names must end in _test or _e2e).
# These defaults point at the same local server; override them to use another one.
# TEST_DATABASE_URL="postgresql://brickflow:brickflow@localhost:5432/brickflow_test"
# E2E_DATABASE_URL="postgresql://brickflow:brickflow@localhost:5432/brickflow_e2e"

# Secret used to sign session tokens. Generate with: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string-of-at-least-32-characters"

# Where uploaded invoice PDFs are stored when STORAGE_DRIVER=local.
STORAGE_DRIVER="local"
STORAGE_DIR="./storage"

# Shared password for all seeded demo accounts.
DEMO_PASSWORD="BrickFlow@2026"

# Demo dataset to seed and show on the sign-in page: "standard" (multi-builder, every
# workflow stage; used by the tests) or "chandak" (one builder, one channel partner, two invoices).
DEMO_DATASET="standard"

# Public base URL (used for absolute links and secure cookies).
APP_URL="http://localhost:3000"

# Field-level encryption key for bank account numbers and PAN (32 random bytes, base64 or hex).
# Required in production. Generate with: openssl rand -base64 32
# Outside production a fixed development key is used when this is empty.
DATA_ENCRYPTION_KEY=""

# Verification provider: "sandbox" (offline, deterministic) or "cashfree". Production requires an
# explicit value and refuses "sandbox" unless ALLOW_SANDBOX_VERIFICATION="true".
VERIFICATION_PROVIDER="sandbox"
# ALLOW_SANDBOX_VERIFICATION="false"
# VERIFICATION_EINVOICE_PROVIDER="quicko"

# Cashfree Secure ID credentials (see docs/INTEGRATIONS.md).
# CASHFREE_VERIFICATION_CLIENT_ID=""
# CASHFREE_VERIFICATION_CLIENT_SECRET=""
# CASHFREE_VERIFICATION_ENV="sandbox"
# CASHFREE_VERIFICATION_PUBLIC_KEY=""

# Sandbox.co.in (Quicko) e-invoice credentials (see docs/INTEGRATIONS.md).
# QUICKO_API_KEY=""
# QUICKO_API_SECRET=""
# QUICKO_ENV="test"
# QUICKO_EINVOICE_GSTIN=""
# QUICKO_EINVOICE_USERNAME=""
# QUICKO_EINVOICE_PASSWORD=""

# KYC policy. KYC_ENFORCED defaults to true in production and false elsewhere.
# KYC_ENFORCED="false"
# KYC_NAME_MATCH_THRESHOLD="80"
# PAYOUT_ACCOUNT_COOLING_OFF_HOURS="72"
# VERIFICATION_CACHE_TTL_HOURS="24"
