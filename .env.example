# SQLite file for local development (relative to the project root).
DATABASE_URL="file:./prisma/dev.db"

# Secret used to sign session tokens. Generate with: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string-of-at-least-32-characters"

# Where uploaded invoice PDFs are stored when STORAGE_DRIVER=local.
STORAGE_DRIVER="local"
STORAGE_DIR="./storage"

# Shared password for all seeded demo accounts.
DEMO_PASSWORD="BrickFlow@2026"

# Demo dataset to seed and show on the sign-in page: "standard" (multi-builder, every
# workflow stage; used by the tests) or "chandak" (one builder, one channel partner, two invoices).
DEMO_DATASET="standard"

# Public base URL (used for absolute links and secure cookies).
APP_URL="http://localhost:3000"
