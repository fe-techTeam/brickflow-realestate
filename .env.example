# PostgreSQL connection for local development. `docker compose up -d postgres` starts a matching
# server on localhost:5432 (user/password "brickflow", database "brickflow").
DATABASE_URL="postgresql://brickflow:brickflow@localhost:5432/brickflow"

# Optional: maximum connections in the app's pool (default 10).
# DATABASE_POOL_MAX="10"

# Databases the automated tests recreate on every run (names must end in _test or _e2e).
# These defaults point at the same local server; override them to use another one.
# TEST_DATABASE_URL="postgresql://brickflow:brickflow@localhost:5432/brickflow_test"
# E2E_DATABASE_URL="postgresql://brickflow:brickflow@localhost:5432/brickflow_e2e"

# Secret used to sign session tokens. Generate with: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string-of-at-least-32-characters"

# Where uploaded invoice PDFs are stored when STORAGE_DRIVER=local.
STORAGE_DRIVER="local"
STORAGE_DIR="./storage"

# Shared password for all seeded demo accounts.
DEMO_PASSWORD="BrickFlow@2026"

# Demo dataset to seed and show on the sign-in page: "standard" (multi-builder, every
# workflow stage; used by the tests) or "chandak" (one builder, one channel partner, two invoices).
DEMO_DATASET="standard"

# Public base URL (used for absolute links and secure cookies).
APP_URL="http://localhost:3000"

# --- Background worker (`npm run worker`) and notifications ---------------------------------

# Email delivery: "log" writes emails to the worker log instead of sending them (default outside
# production); "smtp" sends through any SMTP relay, e.g. Amazon SES SMTP
# (email-smtp.<region>.amazonaws.com, port 587, SMTP credentials from the SES console).
# In production the worker refuses to start without EMAIL_PROVIDER, and refuses "log" unless
# EMAIL_ALLOW_LOG_IN_PRODUCTION=true (for demo environments only).
EMAIL_PROVIDER="log"
# EMAIL_ALLOW_LOG_IN_PRODUCTION="false"
# SMTP_HOST="email-smtp.ap-south-1.amazonaws.com"
# SMTP_PORT="587"                  # 465 uses implicit TLS; other ports require STARTTLS
# SMTP_SECURE=""                   # defaults to true on port 465
# SMTP_REQUIRE_TLS="true"          # set false only for a local relay without TLS
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="BrickFlow <no-reply@example.com>"
# SMTP_RATE_LIMIT_PER_SECOND=""    # e.g. your SES sending rate

# WhatsApp: "none" (default) records WhatsApp deliveries as skipped; "cloud" sends approved
# template messages through the Meta WhatsApp Cloud API. The app needs WHATSAPP_PROVIDER,
# WHATSAPP_APP_SECRET and WHATSAPP_VERIFY_TOKEN for the status webhook at /api/webhooks/whatsapp.
WHATSAPP_PROVIDER="none"
# WHATSAPP_TOKEN=""                 # system-user access token
# WHATSAPP_PHONE_NUMBER_ID=""       # numeric id of the sending business number
# WHATSAPP_APP_SECRET=""            # verifies X-Hub-Signature-256 on webhook callbacks
# WHATSAPP_VERIFY_TOKEN=""          # any random string; also entered in the Meta app dashboard
# WHATSAPP_API_VERSION="v27.0"
# WHATSAPP_TEMPLATE_LANGUAGE="en"

# Worker tuning (defaults shown).
# WORKER_CONCURRENCY="4"
# WORKER_POLL_INTERVAL_MS="1000"
# WORKER_LEASE_MS="60000"           # visibility timeout; renewed every third of it while a job runs
# WORKER_SCHEDULER_INTERVAL_MS="30000"
# WORKER_SHUTDOWN_TIMEOUT_MS="25000"
# WORKER_HANDLER_TIMEOUT_MS="300000"
# WORKER_JOB_TYPES=""               # comma-separated; run a dedicated worker for some job types
# WORKER_HEARTBEAT_FILE=""          # liveness file for container health checks
# JOB_MAX_ATTEMPTS="8"
# JOB_BACKOFF_BASE_MS="5000"
# JOB_BACKOFF_MAX_MS="3600000"
# JOB_RETENTION_DAYS="14"
# SETTLEMENT_REMINDER_CRON="0 9 * * *"   # IST; settlement due/overdue reminders
