{
  "name": "brickflow",
  "version": "0.1.0",
  "private": true,
  "description": "BrickFlow — Real Estate Receivables, Made Liquid. Channel partner invoice discounting demo.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:prepare": "node scripts/prepare-db.mjs --target e2e --storage-dir ./storage/e2e",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "demo:reset": "node scripts/demo-reset.mjs",
    "audit:verify": "tsx scripts/audit-chain.ts verify",
    "audit:backfill": "tsx scripts/audit-chain.ts backfill",
    "audit:anchor": "tsx scripts/audit-chain.ts anchor",
    "audit:export-anchors": "tsx scripts/audit-chain.ts export-anchors",
    "setup": "prisma migrate deploy && prisma db seed",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jose": "6.2.15",
    "lucide-react": "1.66.0",
    "next": "16.4.4",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tesseract.js": "7.0.0",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
