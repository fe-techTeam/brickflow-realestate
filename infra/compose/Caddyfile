# Reverse proxy for docker-compose.prod.yml. Caddy obtains and renews the TLS certificate for
# $DOMAIN automatically (ports 80 and 443 must be reachable and DNS must point at this server).
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Webhook callbacks are small; refuse large bodies before they reach the app.
	handle /api/webhooks/* {
		request_body {
			max_size 1MB
		}
		reverse_proxy app:3000
	}

	reverse_proxy app:3000
}
