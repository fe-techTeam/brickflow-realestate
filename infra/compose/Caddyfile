# Reverse proxy for docker-compose.prod.yml. Caddy obtains and renews the TLS certificate for
# $DOMAIN automatically (ports 80 and 443 must be reachable and DNS must point at this server).
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# A fresh request ID per request; the app returns it as x-request-id and logs it on every line.
	reverse_proxy app:3000 {
		header_up X-Request-Id {http.request.uuid}
	}
}
